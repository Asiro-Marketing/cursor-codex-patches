{
  "name": "claude-chat",
  "displayName": "Claude Chat",
  "description": "Minimal Claude Code chat panel with drag-and-drop file attachment (PDF, images, anything).",
  "publisher": "local",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeChat.open",
        "title": "Claude Chat: Open"
      }
    ],
    "keybindings": [
      {
        "command": "claudeChat.open",
        "key": "cmd+shift+c",
        "mac": "cmd+shift+c"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Asiro-Marketing/cursor-codex-patches.git",
    "directory": "extensions/claude-chat"
  }
}
